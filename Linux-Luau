		BackgroundColor3 = TH.field, BorderSizePixel = 0}, parent)
	local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = TH.accent, BorderSizePixel = 0}, track)
	local knob = new("Frame", {Size = UDim2.fromOffset(8, 14), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = TH.accent, BorderSizePixel = 0}, track)
	local hit = new("TextButton", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 22),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false}, parent)
	local val
	local function show(p)
		fill.Size = UDim2.new(p, 0, 1, 0)
		knob.Position = UDim2.new(p, 0, 0.5, 0)
	end
	local function set(a)
		a = math.clamp(a, 0, 1)
		local v = mn + math.floor(a * (mx - mn) / step + 0.5) * step
		show((v - mn) / (mx - mn))
		if v ~= val then
			val = v
			if onChange then onChange(v) end
		end
	end
	hit.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		set((i.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X))
		dragFn = function(m)
			set((m.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X))
		end
	end)
	set((init - mn) / (mx - mn))
	return {show = show}
end

