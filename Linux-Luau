local function urlEnc(s)
	return (s:gsub("[^%w%-_%.~ ]", function(c) return string.format("%%%02X", c:byte()) end):gsub(" ", "+"))
end

local function urlDec(s)
	return (s:gsub("%+", " "):gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
end

local function htmlText(h)
	h = h:gsub("<script.->.-</script>", ""):gsub("<style.->.-</style>", ""):gsub("<[^>]+>", " ")
	h = h:gsub("&nbsp;", " "):gsub("&quot;", '"'):gsub("&#39;", "'"):gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&amp;", "&")
	return (h:gsub("%s+", " "))
end

local function parseResults(html)
	local out = {}
	for attrs, title in html:gmatch('<a([^>]-result__a[^>]-)>(.-)</a>') do
		local href = attrs:match('href="([^"]+)"') or ""
		local u = href:match("uddg=([^&]+)")
		local url = u and urlDec(u) or href:gsub("^//", "https://")
		local t = htmlText(title)
		if url ~= "" and t ~= "" then table.insert(out, {title = t, url = url}) end
		if #out >= 8 then break end
	end
	return out
end

local function buildNav(body)
	local closed = false
