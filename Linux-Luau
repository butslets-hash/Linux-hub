local function gameCars(area, back)
	local RW, RH = 230, 186
	local lane, score, speed, over, obs, spawnT, alive2 = 2, 0, 90, false, {}, 0, true
	local function laneX(l) return (l - 1) * 77 + 25 end

	local road = new("Frame", {Position = UDim2.fromOffset(10, 24), Size = UDim2.fromOffset(RW, RH),
		BackgroundColor3 = TH.field, BorderSizePixel = 0, ClipsDescendants = true}, area)
	local dashes = {}
	for _, x in ipairs({76, 152}) do
		for j = 0, 5 do
			table.insert(dashes, {x = x, y = j * 40 - 20,
				f = new("Frame", {Size = UDim2.fromOffset(4, 22), BackgroundColor3 = TH.muted, BorderSizePixel = 0}, road)})
		end
	end
	local car = new("Frame", {Size = UDim2.fromOffset(26, 40), Position = UDim2.fromOffset(laneX(lane), RH - 50),
		BackgroundColor3 = TH.accent, BorderSizePixel = 0, ZIndex = 3}, road)
	local scoreL = lbl(area, {Position = UDim2.fromOffset(8, 2), Size = UDim2.fromOffset(170, 18), TextSize = 11, Font = TH.fb})

	local function setLane(n)
		lane = math.clamp(n, 1, 3)
		car.Position = UDim2.fromOffset(laneX(lane), RH - 50)
	end

	local restartB
	local function reset()
		for _, o in ipairs(obs) do o.f:Destroy() end
		obs = {}
		score, speed, over, spawnT = 0, 90, false, 0
		if restartB then
			restartB:Destroy()
			restartB = nil
		end
		scoreL.Text = string.format(tr("g_score"), 0)
		setLane(2)
	end
	local function crash()
		over = true
		sfx(SONS.falha, 0.6)
		scoreL.Text = tr("g_over") .. " · " .. score
		restartB = btn(area, {Position = UDim2.fromOffset(90, 110), Size = UDim2.fromOffset(120, 26)}, tr("g_restart"), reset)
	end

	btn(area, {Position = UDim2.new(1, -62, 0, 2), Size = UDim2.fromOffset(58, 16), TextSize = 9}, tr("back"), back)
	btn(area, {Position = UDim2.fromOffset(10, 216), Size = UDim2.fromOffset(110, 22)}, "<", function()
		if not over then setLane(lane - 1) end
	end)
	btn(area, {Position = UDim2.fromOffset(130, 216), Size = UDim2.fromOffset(110, 22)}, ">", function()
		if not over then setLane(lane + 1) end
	end)
	local kc = UIS.InputBegan:Connect(function(i, gp)
		if gp or over then return end
		local k = i.KeyCode
		if k == Enum.KeyCode.Left or k == Enum.KeyCode.A then
			setLane(lane - 1)
		elseif k == Enum.KeyCode.Right or k == Enum.KeyCode.D then
			setLane(lane + 1)
		end
	end)

	reset()
	task.spawn(function()
		local last = os.clock()
		while alive2 and alive do
			local now = os.clock()
			local dt = math.min(now - last, 0.1)
			last = now
			if not over then
				spawnT = spawnT + dt
				if spawnT > 0.7 then
					spawnT = 0
					local l = math.random(1, 3)
					table.insert(obs, {l = l, y = -40,
						f = new("Frame", {Size = UDim2.fromOffset(26, 40), BackgroundColor3 = TH.muted, BorderSizePixel = 0}, road)})
				end
				for i = #obs, 1, -1 do
					local o = obs[i]
					o.y = o.y + speed * dt
					o.f.Position = UDim2.fromOffset(laneX(o.l), o.y)
					if o.l == lane and o.y + 40 > RH - 50 and o.y < RH - 10 then crash() end
					if o.y > RH then
						o.f:Destroy()
						table.remove(obs, i)
						score = score + 1
						speed = math.min(260, speed + 3)
						scoreL.Text = string.format(tr("g_score"), score)
					end
				end
				for _, d in ipairs(dashes) do
					d.y = (d.y + speed * dt * 0.6) % (RH + 40) - 20
					d.f.Position = UDim2.fromOffset(d.x, d.y)
				end
			end
			task.wait(0.03)
		end
	end)

	return function()
		alive2 = false
		kc:Disconnect()
	end
end

local function gameSnake(area, back)
	local COLS, ROWS, CS = 20, 14, 11
	local board = new("Frame", {Position = UDim2.fromOffset(10, 24), Size = UDim2.fromOffset(COLS * CS, ROWS * CS),
		BackgroundColor3 = TH.field, BorderSizePixel = 0, ClipsDescendants = true}, area)
	local cells = {}
	for x = 1, COLS do
		cells[x] = {}
		for y = 1, ROWS do
			cells[x][y] = new("Frame", {Position = UDim2.fromOffset((x - 1) * CS, (y - 1) * CS),
				Size = UDim2.fromOffset(CS - 1, CS - 1), BackgroundColor3 = TH.field, BorderSizePixel = 0}, board)
		end
	end
	local scoreL = lbl(area, {Position = UDim2.fromOffset(8, 2), Size = UDim2.fromOffset(170, 18), TextSize = 11, Font = TH.fb})
	local snake, dir, nextDir, food, score, over, restartB = {}, {x = 1, y = 0}, {x = 1, y = 0}, nil, 0, false, nil
	local alive2 = true

	local function placeFood()
		local ok = false
		while not ok do
			food = {x = math.random(1, COLS), y = math.random(1, ROWS)}
			ok = true
			for _, s in ipairs(snake) do
				if s.x == food.x and s.y == food.y then
					ok = false
					break
				end
			end
		end
	end
	local function draw()
		for x = 1, COLS do
			for y = 1, ROWS do cells[x][y].BackgroundColor3 = TH.field end
		end
		for i, s in ipairs(snake) do
			cells[s.x][s.y].BackgroundColor3 = (i == 1) and TH.accent or TH.muted
		end
		cells[food.x][food.y].BackgroundColor3 = Color3.fromRGB(230, 60, 60)
	end
	local function reset()
		snake = {{x = 5, y = 7}, {x = 4, y = 7}, {x = 3, y = 7}}
		dir, nextDir = {x = 1, y = 0}, {x = 1, y = 0}
		score, over = 0, false
		if restartB then
			restartB:Destroy()
			restartB = nil
		end
		placeFood()
		draw()
		scoreL.Text = string.format(tr("g_score"), 0)
	end
	local function step()
		dir = nextDir
		local h = {x = snake[1].x + dir.x, y = snake[1].y + dir.y}
		if h.x < 1 or h.x > COLS or h.y < 1 or h.y > ROWS then return false end
		for _, s in ipairs(snake) do
			if s.x == h.x and s.y == h.y then return false end
		end
		table.insert(snake, 1, h)
		if h.x == food.x and h.y == food.y then
			score = score + 1
			sfx(SONS.ok, 0.4)
			placeFood()
			scoreL.Text = string.format(tr("g_score"), score)
		else
			table.remove(snake)
		end
		return true
	end
	local function crash()
		over = true
		sfx(SONS.falha, 0.6)
		scoreL.Text = tr("g_over") .. " · " .. score
		restartB = btn(area, {Position = UDim2.fromOffset(60, 70), Size = UDim2.fromOffset(120, 26)}, tr("g_restart"), reset)
	end
	local function turn(x, y)
		if x ~= -dir.x or y ~= -dir.y then nextDir = {x = x, y = y} end
	end

	btn(area, {Position = UDim2.fromOffset(116, 180), Size = UDim2.fromOffset(28, 22)}, "^", function() turn(0, -1) end)
	btn(area, {Position = UDim2.fromOffset(76, 204), Size = UDim2.fromOffset(28, 22)}, "<", function() turn(-1, 0) end)
	btn(area, {Position = UDim2.fromOffset(116, 204), Size = UDim2.fromOffset(28, 22)}, "v", function() turn(0, 1) end)
	btn(area, {Position = UDim2.fromOffset(156, 204), Size = UDim2.fromOffset(28, 22)}, ">", function() turn(1, 0) end)
	btn(area, {Position = UDim2.new(1, -62, 0, 2), Size = UDim2.fromOffset(58, 16), TextSize = 9}, tr("back"), back)
	local kc = UIS.InputBegan:Connect(function(i, gp)
		if gp or over then return end
		local k = i.KeyCode
		if k == Enum.KeyCode.Up or k == Enum.KeyCode.W then turn(0, -1)
		elseif k == Enum.KeyCode.Down or k == Enum.KeyCode.S then turn(0, 1)
		elseif k == Enum.KeyCode.Left or k == Enum.KeyCode.A then turn(-1, 0)
		elseif k == Enum.KeyCode.Right or k == Enum.KeyCode.D then turn(1, 0) end
	end)

	reset()
	task.spawn(function()
		while alive2 and alive do
			task.wait(0.14)
			if not over then
				if step() then draw() else crash() end
			end
		end
	end)

	return function()
		alive2 = false
		kc:Disconnect()
	end
end

local function gameQuiz(area, back)
	local qs = QUIZ[CFG.lang]
	local idx, score, locked, alive2 = 1, 0, false, true
	local qL = lbl(area, {Position = UDim2.fromOffset(8, 26), Size = UDim2.new(1, -16, 0, 64), TextWrapped = true,
		TextSize = 12, Font = TH.fb, TextYAlignment = Enum.TextYAlignment.Top})
	local scL = lbl(area, {Position = UDim2.fromOffset(8, 2), Size = UDim2.fromOffset(170, 18), TextSize = 11, Font = TH.fb})
	local fbL = lbl(area, {Position = UDim2.fromOffset(8, 222), Size = UDim2.new(1, -16, 0, 16), TextSize = 11, Font = TH.fb})
	local opts, restartB, answer = {}, nil, nil
	for i = 1, 4 do
		opts[i] = btn(area, {Position = UDim2.fromOffset(10, 96 + (i - 1) * 30), Size = UDim2.new(1, -20, 0, 26), TextSize = 11},
			"", function() answer(i) end)
	end

	local function show()
		local q = qs[idx]
		qL.Text = q[1]
		scL.Text = string.format(tr("g_score"), score)
		for i = 1, 4 do
			opts[i].Text = q[2][i]
			opts[i].Visible = true
		end
	end
	local function finish()
		qL.Text = string.format(tr("g_end"), score, #qs)
		for i = 1, 4 do opts[i].Visible = false end
		if not restartB then
			restartB = btn(area, {Position = UDim2.fromOffset(70, 130), Size = UDim2.fromOffset(120, 26)}, tr("g_restart"), function()
				idx, score = 1, 0
				restartB.Visible = false
				fbL.Text = ""
				show()
			end)
		end
		restartB.Visible = true
	end
	answer = function(i)
		if locked or not alive2 then return end
		locked = true
		if i == qs[idx][3] then
			score = score + 1
			fbL.Text = tr("g_ok")
			sfx(SONS.ok, 0.4)
		else
			fbL.Text = tr("g_bad")
			sfx(SONS.falha, 0.5)
		end
		task.delay(0.9, function()
			if not alive2 then return end
			locked = false
			fbL.Text = ""
			idx = idx + 1
			if idx > #qs then finish() else show() end
		end)
	end

	show()
	btn(area, {Position = UDim2.new(1, -62, 0, 2), Size = UDim2.fromOffset(58, 16), TextSize = 9}, tr("back"), back)
	return function() alive2 = false end
end

local function buildGames(body)
	local area = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, body)
	local stopCur
	local menu
	local function clearArea()
		if stopCur then
			stopCur()
			stopCur = nil
		end
		for _, c in ipairs(area:GetChildren()) do c:Destroy() end
	end
	local function open(fn)
		clearArea()
		stopCur = fn(area, menu)
	end
	menu = function()
		clearArea()
		for i, g in ipairs({{"g_cars", gameCars}, {"g_snake", gameSnake}, {"g_quiz", gameQuiz}}) do
			btn(area, {Position = UDim2.fromOffset(35, 40 + (i - 1) * 52), Size = UDim2.fromOffset(180, 38), TextSize = 13},
				tr(g[1]), function() open(g[2]) end)
		end
	end
	menu()
	return function()
		if stopCur then
			stopCur()
			stopCur = nil
		end
	end
end

