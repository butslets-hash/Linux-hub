local function sendToChat(msg)
	msg = cut(msg, 200)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local ch = TextChatService:FindFirstChild("TextChannels")
		local gen = ch and ch:FindFirstChild("RBXGeneral")
		return (gen and pcall(function() gen:SendAsync(msg) end)) or false
	end
	local ev = RS:FindFirstChild("DefaultChatSystemChatEvents")
	local say = ev and ev:FindFirstChild("SayMessageRequest")
	return (say and pcall(function() say:FireServer(msg, "All") end)) or false
end

local MODE_RULES = {
	inferior = "Answer in at most 2 short sentences, straight to the point.",
	medio = "Answer in a normal, clear and balanced way.",
	hard = "Think carefully and answer in a smart, complete and well-reasoned way.",
}
local MODE_TOKENS = {inferior = 4096, medio = 8192, hard = 16384}

local function askAI(system, msgs, mode, cb)
	mode = mode or "medio"
	if not httpRequest then return cb(nil, "no executor request") end
	if API_KEY == "" then return cb(nil, "missing API key") end
	local done = false
	local function finish(text, err)
		if done then return end
		done = true
		cb(text, err)
	end
	task.delay(TIMEOUT, function() finish(nil, "timeout") end)
	local input = {}
	for _, m in ipairs(msgs) do
		table.insert(input, {role = m.role, content = m.text})
	end
	task.spawn(function()
		local ok, res = pcall(httpRequest, {
			Url = MODEL_URL, Method = "POST",
			Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY},
			Body = HttpService:JSONEncode({
				model = MODEL_NAME, instructions = system .. "\n\n" .. MODE_RULES[mode],
				input = input, max_output_tokens = MODE_TOKENS[mode], store = false,
			}),
		})
		if not ok or type(res) ~= "table" then return finish(nil, "no response") end
		local okj, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "")
		if not okj or type(data) ~= "table" then
			return finish(nil, "invalid response (HTTP " .. tostring(res.StatusCode) .. ")")
		end
		if data.error then
			local emsg = type(data.error) == "table" and data.error.message or data.error
			return finish(nil, "API: " .. tostring(emsg))
		end
		local out = {}
		if type(data.output) == "table" then
			for _, item in ipairs(data.output) do
				if item.type == "message" and type(item.content) == "table" then
					for _, c in ipairs(item.content) do
						if c.type == "output_text" and type(c.text) == "string" then
							table.insert(out, c.text)
						end
					end
				end
			end
		end
		local text = table.concat(out)
		if text == "" and type(data.output_text) == "string" then text = data.output_text end
		if text == "" then return finish(nil, "empty reply") end
		finish(text)
	end)
end

