		TextColor3 = TH.muted, Text = ""})
	local view = new("ScrollingFrame", {Position = UDim2.fromOffset(4, 48), Size = UDim2.new(1, -8, 1, -52),
		BackgroundColor3 = TH.term, BorderSizePixel = 0, ScrollBarThickness = 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, body)
	new("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, view)
	new("UIPadding", {PaddingTop = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3)}, view)

	local function clearView()
		for _, c in ipairs(view:GetChildren()) do
			if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
		end
	end

	local function fetch(url, cb)
		if not httpRequest then
			status.Text = tr("w_nreq")
			sfx(SONS.falha, 0.5)
			return
		end
		status.Text = tr("w_load")
		task.spawn(function()
			local ok, res2 = pcall(httpRequest, {Url = url, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
			if closed then return end
			if not ok or type(res2) ~= "table" or type(res2.Body) ~= "string" then
				status.Text = tr("w_fail")
				sfx(SONS.falha, 0.5)
				return
			end
			cb(res2.Body)
		end)
	end

	local showResults
	local function loadUrl(url)
		addr.Text = url
		fetch(url, function(body2)
			clearView()
			lbl(view, {Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
				TextSize = 10, TextYAlignment = Enum.TextYAlignment.Top, Text = cut(htmlText(body2), 2500)})
			status.Text = tr("w_ok")
		end)
	end

	showResults = function(list)
		clearView()
		lastResults = list
		for i, r in ipairs(list) do
			btn(view, {Size = UDim2.new(1, -6, 0, 24), LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Left,
				TextSize = 10, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Text = "  " .. r.title},
				nil, function() loadUrl(r.url) end)
		end
	end

	local function search(q)
		fetch("https://html.duckduckgo.com/html/?q=" .. urlEnc(q), function(body2)
			local list = parseResults(body2)
			if #list == 0 then
				status.Text = tr("w_none")
				sfx(SONS.falha, 0.5)
				return
			end
			status.Text = string.format(tr("w_res"), #list)
			showResults(list)
		end)
	end

	local function go()
		local t = addr.Text:match("^%s*(.-)%s*$")
		if t == "" then return end
		if t:find("^https?://") then
			loadUrl(t)
		elseif t:find("%.") and not t:find("%s") then
			loadUrl("https://" .. t)
		else
			search(t)
		end
	end

	btn(body, {Position = UDim2.fromOffset(118, 4), Size = UDim2.fromOffset(40, 22), BackgroundColor3 = TH.accent,
		TextColor3 = TH.accentText}, tr("go"), go)
	btn(body, {Position = UDim2.fromOffset(162, 4), Size = UDim2.fromOffset(34, 22), TextSize = 10}, tr("back"), function()
		if lastResults then showResults(lastResults) end
	end)
	addr.FocusLost:Connect(function(enter) if enter then go() end end)
	lbl(view, {Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 10,
		TextColor3 = TH.muted, Text = tr("w_hint")})

	return function() closed = true end
end

