local function buildAud(body)
	local STEPS = {1, 5, 10, 20, 30, 40, 50}
	local ri, radius = 6, 50
	local detect, records, playingId, tracked = false, {}, nil, {}
	local prev = new("Sound", {Volume = 0.5}, SoundService)
	local circle = new("Part", {Name = "AreaScan", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, radius * 2, radius * 2),
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Material = Enum.Material.Neon, Color = TH.accent, Transparency = 1}, workspace)

	local list = new("ScrollingFrame", {Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, body)
	new("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, list)
	local statusL = lbl(body, {Position = UDim2.fromOffset(60, 28), Size = UDim2.new(1, -60, 0, 18), TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd})
	local function status(t) statusL.Text = t end

	local function refreshRows()
		for _, row in ipairs(list:GetChildren()) do
			if row:IsA("Frame") then
				local on = playingId ~= nil and row:GetAttribute("SongId") == playingId
				local pb = row:FindFirstChild("Play")
				if pb then setOn(pb, on, on and tr("stop") or tr("play")) end
			end
		end
	end

	local function playSong(id)
		if playingId == id then
			prev:Stop()
			playingId = nil
			refreshRows()
			return
		end
		prev.SoundId = "rbxassetid://" .. id
		prev:Play()
		playingId = id
		status(string.format(tr("au_playing"), id))
		refreshRows()
	end
	prev.Ended:Connect(function()
		playingId = nil
		refreshRows()
	end)

	local function addDetected(sound, owner)
		local id = string.match(sound.SoundId, "%d+")
		if not id or records[id] then return end
		records[id] = true
		local name = (sound.Name ~= "Sound" and sound.Name or tr("au_song")) .. (owner and (" - " .. owner.DisplayName) or "")
		local row = new("Frame", {Size = UDim2.new(1, -4, 0, 26), BackgroundColor3 = TH.field, BorderSizePixel = 0}, list)
		row:SetAttribute("SongId", id)
		lbl(row, {Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -96, 1, 0), TextSize = 10,
			TextTruncate = Enum.TextTruncate.AtEnd, Text = name .. " " .. id})
		btn(row, {Name = "Play", Position = UDim2.new(1, -88, 0, 4), Size = UDim2.fromOffset(40, 18), TextSize = 9},
			tr("play"), function() playSong(id) end)
		btn(row, {Position = UDim2.new(1, -44, 0, 4), Size = UDim2.fromOffset(40, 18), TextSize = 9}, tr("copy"), function()
			if setclipboard then
				setclipboard(id)
				status(string.format(tr("au_copied"), id))
			end
		end)
		refreshRows()
	end

	local detB, radB
	detB = btn(body, {Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(78, 22)}, "", function()
		detect = not detect
		setOn(detB, detect, tr("au_det") .. " " .. (detect and "ON" or "OFF"))
		circle.Transparency = detect and 0.7 or 1
	end)
	setOn(detB, false, tr("au_det") .. " OFF")
	radB = btn(body, {Position = UDim2.fromOffset(82, 0), Size = UDim2.fromOffset(78, 22)}, "", function()
		ri = ri % #STEPS + 1
		radius = STEPS[ri]
		radB.Text = tr("au_rad") .. " " .. radius
		circle.Size = Vector3.new(0.2, radius * 2, radius * 2)
		status(tr("au_rad") .. " " .. radius .. " studs")
	end)
	radB.Text = tr("au_rad") .. " " .. radius
	btn(body, {Position = UDim2.fromOffset(164, 0), Size = UDim2.fromOffset(76, 22)}, tr("au_clr"), function()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		records = {}
	end)
	btn(body, {Position = UDim2.fromOffset(0, 28), Size = UDim2.fromOffset(56, 18), TextSize = 9}, tr("stop"), function()
		if playingId then
			prev:Stop()
			playingId = nil
			refreshRows()
			status(tr("au_stopped"))
		end
	end)

	local function trackSound(d)
		if d:IsA("Sound") then tracked[d] = true end
	end
	for _, d in ipairs(workspace:GetDescendants()) do trackSound(d) end
	local c1 = workspace.DescendantAdded:Connect(trackSound)
	local c2 = workspace.DescendantRemoving:Connect(function(d) tracked[d] = nil end)

	local function soundPos(s)
		local p = s.Parent
		if not p then return nil end
		if p:IsA("BasePart") then return p.Position
		elseif p:IsA("Attachment") then return p.WorldPosition
		elseif p:IsA("Model") then return p:GetPivot().Position
		elseif p.Parent and p.Parent:IsA("BasePart") then return p.Parent.Position end
		return nil
	end
	local function ownerOf(inst)
		local cur = inst
		while cur and cur ~= workspace do
			local p = Players:GetPlayerFromCharacter(cur)
			if p then return p end
			cur = cur.Parent
		end
		return nil
	end

	local gp = RaycastParams.new()
	gp.FilterType = Enum.RaycastFilterType.Exclude
	local acc = 0
	local hb = RunService.Heartbeat:Connect(function(dt)
		local char = LP.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then return end
		gp.FilterDescendantsInstances = {char, circle}
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -100, 0), gp)
		local y = hit and hit.Position.Y or (root.Position.Y - 3)
		circle.CFrame = CFrame.new(root.Position.X, y + 0.1, root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
		acc = acc + dt
		if acc >= 0.5 then
			acc = 0
			if detect then
				for sound in pairs(tracked) do
					if sound.IsPlaying and sound.SoundId ~= "" and sound:IsDescendantOf(workspace) then
						local pos = soundPos(sound)
						if pos and (pos - root.Position).Magnitude <= radius then
							local owner = ownerOf(sound)
							if owner ~= LP then addDetected(sound, owner) end
						end
					end
				end
			end
		end
	end)

	return function()
		hb:Disconnect()
		c1:Disconnect()
		c2:Disconnect()
		prev:Destroy()
		circle:Destroy()
	end
end

