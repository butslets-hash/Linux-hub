local dragFn = nil

local function new(c, p, parent)
	local o = Instance.new(c)
	for k, v in pairs(p or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function sfx(id, vol)
	if not id then return end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol or 0.5
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 5)
end

local function stroke(o, c)
	return new("UIStroke", {Color = c or TH.edge, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end

local function bevel(o, t, up)
	local a, b = TH.hi or WHITE, TH.sh or Color3.fromRGB(128, 128, 128)
	if not up then a, b = b, a end
	new("Frame", {Size = UDim2.new(1, 0, 0, t), BackgroundColor3 = a, BorderSizePixel = 0}, o)
	new("Frame", {Size = UDim2.new(0, t, 1, 0), BackgroundColor3 = a, BorderSizePixel = 0}, o)
	new("Frame", {Size = UDim2.new(1, 0, 0, t), Position = UDim2.new(0, 0, 1, -t), BackgroundColor3 = b, BorderSizePixel = 0}, o)
	new("Frame", {Size = UDim2.new(0, t, 1, 0), Position = UDim2.new(1, -t, 0, 0), BackgroundColor3 = b, BorderSizePixel = 0}, o)
end

local function box(o, up)
	if TH.bev > 0 then bevel(o, TH.bev, up) else stroke(o) end
end

local function lbl(parent, p)
	local d = {BackgroundTransparency = 1, BorderSizePixel = 0, Font = TH.font, TextSize = 11,
		TextColor3 = TH.text, TextXAlignment = Enum.TextXAlignment.Left, Text = ""}
	for k, v in pairs(p or {}) do d[k] = v end
	return new("TextLabel", d, parent)
end

local function btn(parent, p, text, onClick)
	local d = {AutoButtonColor = false, BorderSizePixel = 0, BackgroundColor3 = TH.btn, TextColor3 = TH.btnText,
		Font = TH.font, TextSize = 11, TextWrapped = true, Text = text or ""}
	for k, v in pairs(p or {}) do d[k] = v end
	local b = new("TextButton", d, parent)
	if d.BackgroundTransparency ~= 1 then box(b, true) end
	b.MouseButton1Click:Connect(function()
		sfx(SONS.clique, 0.3)
		if onClick then onClick() end
	end)
	return b
end

local function plainBtn(parent, p, onClick)
	local b = new("TextButton", p, parent)
	b.AutoButtonColor = false
	b.MouseButton1Click:Connect(function()
		sfx(SONS.clique, 0.3)
		if onClick then onClick() end
	end)
	return b
end

local function field(parent, p)
	local d = {BackgroundColor3 = TH.field, BorderSizePixel = 0, TextColor3 = TH.text, PlaceholderColor3 = TH.muted,
		Font = Enum.Font.Code, TextSize = 11, Text = "", ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left}
	for k, v in pairs(p or {}) do d[k] = v end
	local t = new("TextBox", d, parent)
	box(t, false)
	return t
end

local function setOn(b, on, text)
	b.Text = text
	b.BackgroundColor3 = on and TH.accent or TH.btn
	b.TextColor3 = on and TH.accentText or TH.btnText
end

local function esc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function col(hex, s)
	return '<font color="#' .. hex .. '">' .. esc(s) .. '</font>'
end

local function cut(s, n)
	local p = utf8.offset(s, n + 1)
	if p then return s:sub(1, p - 1) end
	return s
end

local function clean(t)
	return (t:gsub("%*%*", ""):gsub("#+ ", ""))
end

local function keyValid(s)
	return #s >= 25 and s:sub(1, 3) == "sk-" and not s:find("%s")
end

local function mmss(t)
	t = math.max(0, math.floor(t or 0))
	return string.format("%d:%02d", math.floor(t / 60), t % 60)
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

-- um único arraste ativo por vez (janelas, bolinha, sliders)
UIS.InputChanged:Connect(function(i)
	if dragFn and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		dragFn(i)
	end
end)
UIS.InputEnded:Connect(function(i)
	if isPress(i) then dragFn = nil end
end)

local function draggable(handle, target, bounds, onDown)
	local info = {moved = 0}
	handle.InputBegan:Connect(function(i)
		if not isPress(i) then return end
		local origin = i.Position
		local p = target.Position
		local sx, sy, ox, oy = p.X.Offset, p.Y.Offset, p.X.Scale, p.Y.Scale
		info.moved = 0
		if onDown then onDown() end
		dragFn = function(m)
			if not target.Parent then
				dragFn = nil
				return
			end
			local d = m.Position - origin
			info.moved = math.max(info.moved, math.abs(d.X) + math.abs(d.Y))
			local nx, ny = sx + d.X, sy + d.Y
			if bounds then
				nx = math.clamp(nx, 0, math.max(0, bounds.AbsoluteSize.X - target.AbsoluteSize.X))
				ny = math.clamp(ny, 0, math.max(0, bounds.AbsoluteSize.Y - target.AbsoluteSize.Y))
			end
			target.Position = UDim2.new(ox, nx, oy, ny)
		end
	end)
	return info
end

