	paint = function()
		setOn(sB, sOn, tr("v_speed") .. " " .. (sOn and "ON" or "OFF") .. " [" .. speed .. "]")
		setOn(jB, jOn, tr("v_jump") .. " " .. (jOn and "ON" or "OFF") .. " [" .. jump .. "]")
		setOn(gB, gOn, tr("v_grav") .. " " .. (gOn and "ON" or "OFF"))
	end

	slider(body, 0, 26, 240, MIN_V, MAX_V, 1, speed, function(v) speed = v; paint() end)
	slider(body, 0, 78, 240, MIN_V, MAX_V, 1, jump, function(v) jump = v; paint() end)

	local numL = lbl(body, {Position = UDim2.fromOffset(156, 104), Size = UDim2.fromOffset(30, 18),
		TextXAlignment = Enum.TextXAlignment.Center, Text = "0"})
	local function setEx(n)
		extra = math.clamp(n, 0, MAX_EX)
		numL.Text = tostring(extra)
	end
	lbl(body, {Position = UDim2.fromOffset(0, 106), Size = UDim2.fromOffset(150, 16), Text = tr("v_extra")})
	btn(body, {Position = UDim2.fromOffset(130, 102), Size = UDim2.fromOffset(22, 22)}, "-", function() setEx(extra - 1) end)
	btn(body, {Position = UDim2.fromOffset(190, 102), Size = UDim2.fromOffset(22, 22)}, "+", function() setEx(extra + 1) end)
	lbl(body, {Position = UDim2.fromOffset(0, 154), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted, Text = tr("v_air")})

	table.insert(conns, RunService.Heartbeat:Connect(function()
		local h = hum()
		if h then
			if sOn and h.WalkSpeed ~= speed then h.WalkSpeed = speed end
			if jOn then
				if not h.UseJumpPower then h.UseJumpPower = true end
				if h.JumpPower ~= jump then h.JumpPower = jump end
			end
			if h.FloorMaterial ~= Enum.Material.Air then
				used = 0
				airSince = nil
			elseif not airSince then
				airSince = os.clock()
			end
		end
		if gOn and workspace.Gravity ~= LOW_G then workspace.Gravity = LOW_G end
	end))
	table.insert(conns, UIS.JumpRequest:Connect(function()
		local h = hum()
		if extra <= 0 or not h or h.Health <= 0 or h.FloorMaterial ~= Enum.Material.Air then return end
		if not airSince or os.clock() - airSince < 0.12 then return end
		if os.clock() - lastEx < 0.2 or used >= extra then return end
		used = used + 1
		lastEx = os.clock()
		h:ChangeState(Enum.HumanoidStateType.Jumping)
	end))

	paint()
	return function()
		for _, c in ipairs(conns) do c:Disconnect() end
		local h = hum()
		if h then
			if sOn then h.WalkSpeed = orig.ws end
			if jOn then
				h.JumpPower = orig.jp
				h.UseJumpPower = orig.ujp
			end
		end
		if gOn then workspace.Gravity = orig.g end
	end
end

