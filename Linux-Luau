local serverLog, serverVer = {}, 0
local function pushServer(name, text)
	if not text or text == "" then return end
	table.insert(serverLog, {name = name, text = text})
	if #serverLog > 60 then table.remove(serverLog, 1) end
	serverVer = serverVer + 1
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.MessageReceived:Connect(function(m)
		local src = m.TextSource
		if not src then return end
		local p = Players:GetPlayerByUserId(src.UserId)
		pushServer(p and p.DisplayName or "?", m.Text)
	end)
else
	local function hook(p)
		p.Chatted:Connect(function(msg) pushServer(p.DisplayName, msg) end)
	end
	for _, p in ipairs(Players:GetPlayers()) do hook(p) end
	Players.PlayerAdded:Connect(hook)
