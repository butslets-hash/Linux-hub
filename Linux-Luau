local function buildCfg(body)
	lbl(body, {Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted, Text = tr("cfg_lang")})
	for i = 1, 3 do
		local on = CFG.lang == i
		btn(body, {Position = UDim2.fromOffset((i - 1) * 82, 16), Size = UDim2.fromOffset(78, 22),
			BackgroundColor3 = on and TH.accent or TH.btn, TextColor3 = on and TH.accentText or TH.btnText},
			LANGLBL[i], function() setLang(i) end)
	end
	lbl(body, {Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted, Text = tr("cfg_theme")})
	for i, k in ipairs({"linux", "w98", "w95", "xp"}) do
		local on = CFG.theme == k
		btn(body, {Position = UDim2.fromOffset(((i - 1) % 2) * 122, 60 + math.floor((i - 1) / 2) * 26), Size = UDim2.fromOffset(118, 22),
			BackgroundColor3 = on and TH.accent or TH.btn, TextColor3 = on and TH.accentText or TH.btnText},
			THEMES[k].name, function() setTheme(k) end)
	end
	lbl(body, {Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted, Text = tr("cfg_bg")})
	local onB
	onB = btn(body, {Position = UDim2.fromOffset(0, 134), Size = UDim2.new(1, 0, 0, 22)}, "", function()
		CFG.bgOn = not CFG.bgOn
		setOn(onB, CFG.bgOn, CFG.bgOn and tr("cfg_on") or tr("cfg_off"))
	end)
	setOn(onB, CFG.bgOn, CFG.bgOn and tr("cfg_on") or tr("cfg_off"))
	lbl(body, {Position = UDim2.fromOffset(0, 160), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted, Text = tr("cfg_id")})
	local idF = field(body, {Position = UDim2.fromOffset(0, 176), Size = UDim2.new(1, 0, 0, 22), TextSize = 11, Text = CFG.bgId})
	local msg = lbl(body, {Position = UDim2.fromOffset(0, 226), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted})
	btn(body, {Position = UDim2.fromOffset(0, 202), Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = TH.accent,
		TextColor3 = TH.accentText}, tr("cfg_apply"), function()
		CFG.bgId = idF.Text:match("%d+") or ""
		applyBg()
		msg.Text = tr("cfg_saved")
	end)
end

