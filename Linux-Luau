local function buildTerm(body, ctx)
	local lines = {}
	local out = new("ScrollingFrame", {Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -27),
		BackgroundColor3 = TH.term, BorderSizePixel = 0, ScrollBarThickness = 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, body)
	local txt = lbl(out, {Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top, RichText = true, Font = Enum.Font.Code, TextSize = 11,
		TextColor3 = TH.termText})

	local function say(s)
		table.insert(lines, s)
		if #lines > 80 then table.remove(lines, 1) end
		txt.Text = table.concat(lines, "\n")
		task.defer(function()
			if out.Parent then out.CanvasPosition = Vector2.new(0, 1e6) end
		end)
	end

	lbl(body, {Position = UDim2.new(0, 4, 1, -22), Size = UDim2.fromOffset(92, 18), Font = Enum.Font.Code,
		TextSize = 10, TextColor3 = TH.accent, Text = "user@roblox:~$"})
	local input = field(body, {Position = UDim2.new(0, 96, 1, -22), Size = UDim2.new(1, -100, 0, 18),
		TextSize = 11, PlaceholderText = tr("t_ph")})

	local cmds = {}
	function cmds.help() say(tr("t_help")) end
	function cmds.ls()
		local t = {}
		for _, a in ipairs(APPS) do table.insert(t, a.id) end
		say(table.concat(t, "  "))
	end
	function cmds.clear()
		lines = {}
		txt.Text = ""
	end
	function cmds.whoami() say(LP.Name) end
	function cmds.date() say(os.date("%d/%m/%Y %H:%M:%S")) end
	function cmds.uname() say("Linux roblox 6.8.0-roblox #1 SMP x86_64 GNU/Linux") end
	function cmds.echo(a) say(esc(a)) end
	function cmds.exit() ctx.close() end
	function cmds.abrir(a)
		local app = APPID[(a or ""):lower()]
		if app then
			openApp(app)
			return true
		end
		say(col("FF5F5F", tr("t_nfapp") .. (a or "")))
		return false
	end

	local function run(raw)
		local line = raw:match("^%s*(.-)%s*$")
		if line == "" then return end
		say(col("E95420", "user@roblox") .. ":~$ " .. esc(line))
		local cmd, arg = line:match("^(%S+)%s*(.*)$")
		local f = cmds[cmd:lower()]
		if not f then
			say(col("FF5F5F", tr("t_nf") .. cmd))
			sfx(SONS.falha, 0.5)
			return
		end
		if f(arg) == false then sfx(SONS.falha, 0.5) end
	end

	input.FocusLost:Connect(function(enter)
		if enter then
			local t = input.Text
			input.Text = ""
			run(t)
			input:CaptureFocus()
		end
	end)

	say(col("E95420", "Ubuntu Roblox 22.04 LTS") .. " · " .. tr("a_term"))
	say(tr("t_hint"))
end

