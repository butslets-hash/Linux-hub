local function buildMusic(body)
	local closed = false
	local idBox = field(body, {Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 22), TextSize = 11,
		PlaceholderText = tr("m_ph")})
	local nowL = lbl(body, {Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted})
	local timeL = lbl(body, {Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, Font = Enum.Font.Code})
	local seek = slider(body, 0, 90, 240, 0, 1, 0.001, 0, function(p)
		if music.TimeLength > 0 then music.TimePosition = p * music.TimeLength end
	end)
	lbl(body, {Position = UDim2.fromOffset(0, 112), Size = UDim2.new(1, 0, 0, 12), TextSize = 9, TextColor3 = TH.muted, Text = tr("m_vol")})
	slider(body, 0, 126, 240, 0, 1, 0.05, music.Volume, function(p) music.Volume = p end)
	local st = lbl(body, {Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 0, 30), TextSize = 10,
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top})

	local function play()
		local id = idBox.Text:match("%d+")
		if not id then
			musicErr = tr("m_bad")
			sfx(SONS.falha, 0.5)
			return
		end
		musicErr = nil
		musicId = id
		music.SoundId = "rbxassetid://" .. id
		music:Play()
		task.delay(5, function()
			if musicId == id and music.TimeLength == 0 then
				music:Stop()
				musicErr = tr("m_fail")
				sfx(SONS.falha, 0.5)
			end
		end)
	end
	local function stop()
		music:Stop()
		musicErr = nil
	end

	btn(body, {Position = UDim2.fromOffset(0, 26), Size = UDim2.fromOffset(118, 22), BackgroundColor3 = TH.accent,
		TextColor3 = TH.accentText}, tr("play"), play)
	btn(body, {Position = UDim2.fromOffset(122, 26), Size = UDim2.fromOffset(118, 22)}, tr("stop"), stop)
	idBox.FocusLost:Connect(function(enter) if enter then play() end end)

	task.spawn(function()
		while not closed and alive do
			local len = music.TimeLength
			seek.show(len > 0 and math.clamp(music.TimePosition / len, 0, 1) or 0)
			timeL.Text = mmss(music.TimePosition) .. " / " .. mmss(len)
			nowL.Text = music.IsPlaying and string.format(tr("m_now"), musicId or "?") or tr("m_idle")
			st.Text = musicErr or ""
			st.TextColor3 = musicErr and RED or TH.muted
			task.wait(0.2)
		end
	end)

	return function() closed = true end
end

