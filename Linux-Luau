local function buildTp(body)
	local MAXD, CD = 5000, 9.5
	local on, cdEnd = false, 0
	local conns = {}

	local function tpTo(pos, normal)
		local char = LP.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
		local boxCF, boxSize = char:GetBoundingBox()
		local feetToRoot = hrp.Position.Y - (boxCF.Position.Y - boxSize.Y / 2)
		local width = math.max(hrp.Size.X, hrp.Size.Z) + 1.5
		local radius = width / 2
		local check = Vector3.new(width, math.max(boxSize.Y - 0.4, 1), width)
		local flat = Vector3.new(normal.X, 0, normal.Z)
		local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.zero
		local feet = pos + dir * (radius + 0.3)
		local ov = OverlapParams.new()
		ov.FilterType = Enum.RaycastFilterType.Exclude
		ov.FilterDescendantsInstances = {char}
		ov.RespectCanCollide = true
		local chosen = feet
		for i = 0, 30 do
			local cand = feet + Vector3.new(0, i * 0.5, 0) + dir * (i * 0.15)
			local c = cand + Vector3.new(0, check.Y / 2 + 0.2, 0)
			if #workspace:GetPartBoundsInBox(CFrame.new(c), check, ov) == 0 then
				chosen = cand
				break
			end
		end
		local rot = hrp.CFrame - hrp.CFrame.Position
		char:PivotTo(CFrame.new(chosen + Vector3.new(0, feetToRoot + 0.1, 0)) * rot)
		hrp.AssemblyLinearVelocity = Vector3.zero
		return true
	end

	local tB
	tB = btn(body, {Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 22)}, "", function()
		on = not on
		setOn(tB, on, tr("a_tp") .. " " .. (on and "ON" or "OFF"))
	end)
	setOn(tB, false, tr("a_tp") .. " OFF")
	local stat = lbl(body, {Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 14), Text = tr("tp_ready")})
	lbl(body, {Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted, Text = tr("tp_click")})
	lbl(body, {Position = UDim2.fromOffset(0, 68), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = TH.muted,
		Text = string.format(tr("tp_cd"), CD)})

	table.insert(conns, RunService.Heartbeat:Connect(function()
		local r = cdEnd - os.clock()
		stat.Text = r > 0 and string.format(tr("tp_wait"), r) or tr("tp_ready")
	end))
	table.insert(conns, UIS.InputBegan:Connect(function(input, gp)
		if gp or not on or os.clock() < cdEnd then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local ray = workspace.CurrentCamera:ScreenPointToRay(input.Position.X, input.Position.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = LP.Character and {LP.Character} or {}
		local res = workspace:Raycast(ray.Origin, ray.Direction * MAXD, params)
		if res and tpTo(res.Position, res.Normal) then cdEnd = os.clock() + CD end
	end))

	return function()
		for _, c in ipairs(conns) do c:Disconnect() end
	end
end

